// Define mesh boundary
border C1(t=0, pi){x=cos(t); y=sin(t);}
border C2(t=pi, 2*pi){x=cos(t); y=sin(t);}
border D(t=0, 2*pi){x=0.5*cos(t)+0.3; y=0.5*sin(t);}

// Construit un maillage triangulaire entre les deux cercles :
mesh Th = buildmesh(C1(25) + C2(25) + D(-30));

// The finite element space defined over Th is called here Vh
fespace Vh(Th, P1);
Vh w, wNext, T, v;
Vh mu, muNext;

// Parameters for the fixed-point method
func beta = 200;
real muT = 50;
real ntarget = 0.7;
real epsilon = 1e-8;
real tolerance = 1e-6;
int maxIterations = 100;

// Initialisation
w = 0;
mu = muT;

real cpu = clock();
// ofstream errorFile("iteration_errors.csv");
// errorFile << "iteration,errW,errMu" << endl;

for (int stage = 0; stage <= 5; stage++) {
    real pas = (1.0 - ntarget) / 5.0;
    real n = 1.0 - 0.18 * stage;
    cout << "Continuation : n = " << n << endl;

    for (int k = 0; k < maxIterations; k++) {
        // mu^(k+1) = muT |grad(w^k)|^(n-1)
        muNext = muT * pow(
            sqrt(dx(w)*dx(w) + dy(w)*dy(w) + epsilon*epsilon),
            n-1
        );

        // Solve -div(mu^(k+1) grad(w^(k+1))) = beta
        solve FixedPoint(wNext, v, solver=LU)
            = int2d(Th)(
                  muNext*(dx(wNext)*dx(v) + dy(wNext)*dy(v))
              )
              - int2d(Th)(beta*v)
              + on(C1, wNext=0)
              + on(C2, wNext=0)
              + on(D, wNext=0);

        real errW = sqrt(int2d(Th)((wNext-w)*(wNext-w)));
        real errMu = sqrt(int2d(Th)((muNext-mu)*(muNext-mu)));
        // errorFile << k+1 << "," << errW << "," << errMu << endl;

        cout << "Iteration " << k+1
             << " : errW = " << errW
             << " , errMu = " << errMu << endl;

        mu = 0.5 *mu + 0.5*muNext; // relaxation
        w = wNext;

        if (errW < tolerance && errMu < tolerance)
            break;
    }
}
// errorFile << flush;

// Parameter k
real k = 1.0;

// Define the right hand side term /!\ inclure le k et le mu dans le terme de droite
func f = (dx(w)*dx(w)+dy(w)*dy(w))*mu/k;

// Flux normal impose sur C2 : dT/dn = fluxC2
func fluxC2 = 0.;

// Define the PDE
solve Temperature(T, v, solver=LU)
    = int2d(Th)(    // The bilinear part
          dx(T)*dx(v)
        + dy(T)*dy(v)
    )
    - int2d(Th)(    // The right hand side
          f*v
    )
    - int1d(Th, C2)( // Condition de Neumann : dT/dn = fluxC2 (inutile ici, permet de montrer qu'on ne l'a pas oublier)
        fluxC2*v
        )
    + on(C1, T=0)    // Dirichlet condition on C1
    + on(D, T=100);

// Plot the result
plot(T, value=true, fill=true, wait=true, cmm="Temperature distribution");
plot(w, value=true, fill=true, wait=true, cmm="w distribution");

cout << "CPU time = " << (clock()-cpu) << endl;



