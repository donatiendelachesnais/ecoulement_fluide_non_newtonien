// Define mesh boundary
border C1(t=0, pi){x=cos(t); y=sin(t);}
border C2(t=pi, 2*pi){x=cos(t); y=sin(t);}
border D(t=0, 2*pi){x=0.5*cos(t)+0.3; y=0.5*sin(t);}

// Construit un maillage triangulaire entre les deux cercles :
mesh Th = buildmesh(C1(25) + C2(25) + D(-30));

// The finite element space defined over Th is called here Vh
fespace Vh(Th, P1);
Vh w, wNext, v;
Vh mu, muNext;

// Parameters for the fixed-point method
func beta = 200;
real muT = 50;
real n = 0.5;
real epsilon = 1e-8;
real tolerance = 1e-6;
int maxIterations = 100;

// Initialisation
w = 0;
mu = muT;

real cpu = clock();

for (int k = 0; k < maxIterations; k++) {
    // mu^(k+1) = muT |grad(w^k)|^(n-1)
    muNext = muT * pow(
        sqrt(dx(w)*dx(w) + dy(w)*dy(w) + epsilon*epsilon),
        n-1
    );

    // Solve -div(mu^(k+1) grad(w^(k+1))) = beta
    solve FixedPoint(wNext, v, solver=LU)
        = int2d(Th)(
              muNext*(dx(wNext)*dx(v) + dy(wNext)*dy(v))
          )
          - int2d(Th)(beta*v)
          + on(C1, wNext=0)
          + on(C2, wNext=0)
          + on(D, wNext=0);

    real errW = sqrt(int2d(Th)((wNext-w)*(wNext-w)));
    real errMu = sqrt(int2d(Th)((muNext-mu)*(muNext-mu)));

    cout << "Iteration " << k+1
         << " : errW = " << errW
         << " , errMu = " << errMu << endl;

    mu = muNext;
    w = wNext;

    if (errW < tolerance && errMu < tolerance)
        break;
}

// Parameters for the Newton method
real newtonTolerance = 1e-6;
int newtonMaxIterations = 50;
Vh h, phi;

// Initialisation: the fixed-point solution is used as the first Newton iterate
wNext = w;

for (int k = 0; k < newtonMaxIterations; k++) {
    solve Newton(h, phi, solver=LU)
        = int2d(Th)(
              muT * pow(sqrt(dx(w)*dx(w) + dy(w)*dy(w) + epsilon*epsilon), n-1)
                * (dx(h)*dx(phi) + dy(h)*dy(phi))
              + muT * (n-1)
                * pow(sqrt(dx(w)*dx(w) + dy(w)*dy(w) + epsilon*epsilon), n-3)
                * (dx(w)*dx(h) + dy(w)*dy(h))
                * (dx(w)*dx(phi) + dy(w)*dy(phi))
          )
          - int2d(Th)(
              - muT
                * pow(sqrt(dx(w)*dx(w) + dy(w)*dy(w) + epsilon*epsilon), n-1)
                * (dx(w)*dx(phi) + dy(w)*dy(phi))
              + beta*phi
          )
          + on(C1, h=0)
          + on(C2, h=0)
          + on(D, h=0);

    w = w + h;

    real errH = sqrt(int2d(Th)(h*h));
    cout << "Newton iteration " << k+1
         << " : ||h|| = " << errH << endl;

    if (errH < newtonTolerance)
        break;
}

// Plot the Newton solution
plot(w, value=true, fill=true);

cout << "CPU time = " << (clock()-cpu) << endl;



